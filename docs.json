{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "palm",
  "name": "Nimbus",
  "version": "2.2.0",
  "colors": {
    "primary": "#8B6914",
    "light": "#FFE066",
    "dark": "#B8860B"
  },
  "modeToggle": {
    "default": "dark",
    "isHidden": true
  },
  "appearance": {
    "default": "dark",
    "strict": true
  },
  "favicon": "/favicon.svg",
  "api": {
    "baseUrl": "https://api.nimbusbci.com",
    "playground": {
      "mode": "simple"
    }
  },
  "search": {
    "prompt": "Search Nimbus BCI docs..."
  },
  "topbarLinks": [
    {
      "name": "API Status",
      "url": "https://api.nimbusbci.com/api/health"
    },
    {
      "name": "Changelog",
      "url": "https://pypi.org/project/nimbus-bci/#history"
    }
  ],
  "tabs": [
    {
      "name": "Python SDK",
      "url": "python-sdk/introduction"
    },
    {
      "name": "Julia SDK",
      "url": "julia-sdk/quickstart"
    }
  ],
  "navigation": {
    "groups": [
      {
        "group": "Getting started",
        "pages": [
          "index",
          "quickstart"
        ]
      },
      {
        "group": "Personalizer",
        "pages": [
          "personalizer/overview",
          "personalizer/encoder-contract",
          "personalizer/brain-state",
          "python-sdk/active-learning",
          "personalizer/evidence"
        ]
      },
      {
        "group": "Python SDK",
        "pages": [
          "python-sdk/introduction",
          "python-sdk/installation",
          "python-sdk/quickstart",
          "python-sdk/mne-integration",
          "python-sdk/sklearn-integration",
          "python-sdk/streaming-inference",
          "python-sdk/api-reference"
        ]
      },
      {
        "group": "Inference & pipelines",
        "pages": [
          "inference-configuration/preprocessing-requirements",
          "inference-configuration/feature-normalization",
          "inference-configuration/real-time-setup",
          "inference-configuration/batch-processing",
          "inference-configuration/streaming-inference",
          "inference-configuration/error-handling"
        ]
      },
      {
        "group": "Heads & models",
        "pages": [
          "model-specification",
          "models/rxlda",
          "models/rxgmm",
          "models/rxpolya",
          "models/nimbusprobit",
          "models/rxsts"
        ]
      },
      {
        "group": "Concepts",
        "pages": [
          "core-concepts/why-bayesian-bci",
          "core-concepts/probabilistic-ai"
        ]
      },
      {
        "group": "Julia SDK",
        "pages": [
          "julia-sdk/quickstart",
          "julia-sdk/api-reference",
          "julia-sdk/streaming-inference",
          "core-concepts/message-passing"
        ]
      },
      {
        "group": "Cloud API",
        "pages": [
          "cloud-api/introduction",
          "cloud-api/authentication",
          "cloud-api/inference-endpoints"
        ]
      },
      {
        "group": "Examples",
        "pages": [
          "examples/basic-examples",
          "examples/advanced-applications",
          "examples/industry-use-cases",
          "development",
          "development/preprocessing-integration"
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/python-sdk/middleware",
      "destination": "/personalizer/overview"
    },
    {
      "source": "/api-reference/introduction",
      "destination": "/cloud-api/introduction"
    },
    {
      "source": "/api-reference/authentication",
      "destination": "/cloud-api/authentication"
    },
    {
      "source": "/api-reference/inference-endpoints",
      "destination": "/cloud-api/inference-endpoints"
    },
    {
      "source": "/api-reference/streaming-api",
      "destination": "/julia-sdk/streaming-inference"
    },
    {
      "source": "/api-reference/julia-sdk",
      "destination": "/julia-sdk/api-reference"
    },
    {
      "source": "/cloud-api/streaming-api",
      "destination": "/julia-sdk/streaming-inference"
    },
    {
      "source": "/core-concepts/uncertainty-handling",
      "destination": "/core-concepts/probabilistic-ai"
    },
    {
      "source": "/core-concepts/real-time-processing",
      "destination": "/inference-configuration/real-time-setup"
    },
    {
      "source": "/v1/installer/github-token",
      "destination": "/cloud-api/authentication#get-/v1/installer/github-token"
    }
  ],
  "anchors": [
    {
      "name": "Website",
      "url": "https://nimbusbci.com",
      "icon": "globe"
    },
    {
      "name": "Book a Demo",
